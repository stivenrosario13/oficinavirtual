# Backend ASP.NET Core + SQL Server
APP_ENV=development
APP_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=cambia-esta-contrasena-segura
ConnectionStrings__DefaultConnection=Server=localhost;Database=registro_agencias;User Id=registro_app;Password=CONTRASENA;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Connection Timeout=30
MAX_GPS_ACCURACY_METERS=100
VITE_MAX_GPS_ACCURACY_METERS=100
VITE_MAX_IMAGE_SIZE_MB=5

# Web Push/PWA: genere el par una sola vez y conserve las mismas claves entre despliegues.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@grupotejeda.com

# Licenciamiento central (activar solo después de configurar todos los valores)
LICENSE_ENFORCEMENT_ENABLED=false
LICENSE_SERVER_URL=https://licencias.example.com
LICENSE_KEY=LIC-XXXXXXXX-XXXXXXXX-XXXXXXXX
LICENSE_INSTALLATION_ID=genere-un-identificador-aleatorio-de-64-caracteres
LICENSE_DOMAIN=sistema.example.com
# Clave pública ECDSA P-256 PEM; puede escribirse en una sola línea usando \\n
LICENSE_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\\nREEMPLAZAR\\n-----END PUBLIC KEY-----
# Alternativa recomendada para MonsterASP: SubjectPublicKeyInfo DER en Base64.
LICENSE_PUBLIC_KEY_BASE64=
LICENSE_PUBLIC_X_BASE64=
LICENSE_PUBLIC_Y_BASE64=
LICENSE_REFRESH_MINUTES=30
LICENSE_GRACE_HOURS=48
