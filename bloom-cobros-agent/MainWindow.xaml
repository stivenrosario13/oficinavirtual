<Window x:Class="BloomCobrosAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bloom Cobros Agent" Height="820" Width="1320" MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen" Background="#07110E">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBg" Color="#07110E"/><SolidColorBrush x:Key="Panel" Color="#0D1D18"/><SolidColorBrush x:Key="Panel2" Color="#122820"/><SolidColorBrush x:Key="Line" Color="#214437"/><SolidColorBrush x:Key="Accent" Color="#2AD990"/><SolidColorBrush x:Key="TextMain" Color="#EDF8F3"/><SolidColorBrush x:Key="TextMuted" Color="#91ACA0"/>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/><Setter Property="Foreground" Value="{StaticResource TextMain}"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#173329"/><Setter Property="Padding" Value="8,0"/><Setter Property="Foreground" Value="#DDEDE6"/><Setter Property="Background" Value="Transparent"/><Setter Property="VerticalContentAlignment" Value="Center"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#215841"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#10251D"/><Setter Property="Foreground" Value="#8FB4A4"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#285040"/></Style>
        <Style TargetType="DataGridRow"><Setter Property="Background" Value="#0D1D18"/><Setter Property="Foreground" Value="#DDEDE6"/><Setter Property="BorderThickness" Value="0"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#142D24"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#215841"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid Background="{StaticResource PageBg}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" BorderBrush="#18392D" BorderThickness="0,0,1,0">
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0B2B20" Offset="0"/><GradientStop Color="#081A15" Offset="0.55"/><GradientStop Color="#07130F" Offset="1"/></LinearGradientBrush></Border.Background>
            <Grid Margin="26,26,22,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel><Grid Width="54" Height="54" HorizontalAlignment="Left"><Ellipse Fill="#173F30" Stroke="#37E59B" StrokeThickness="1"/><TextBlock Text="B" Foreground="#46E9A5" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid><TextBlock Text="BLOOM" FontSize="23" FontWeight="SemiBold" Margin="0,15,0,0"/><TextBlock Text="COBROS  /  AGENT" Foreground="#66C99B" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Row="1" Margin="0,52,0,0"><Border Background="#183C2F" BorderBrush="#28674E" BorderThickness="1" CornerRadius="9" Padding="13"><TextBlock Text="▰   Centro de control" Foreground="White" FontWeight="SemiBold"/></Border><TextBlock Text="⌕   Clientes" Foreground="#A8C7B9" Margin="13,24,0,0" FontSize="14"/><TextBlock Text="✉   Campañas" Foreground="#A8C7B9" Margin="13,22,0,0" FontSize="14"/><TextBlock Text="⊘   Exclusiones" Foreground="#A8C7B9" Margin="13,22,0,0" FontSize="14"/><TextBlock Text="◷   Historial" Foreground="#A8C7B9" Margin="13,22,0,0" FontSize="14"/><TextBlock Text="⚙   Configuración" Foreground="#A8C7B9" Margin="13,22,0,0" FontSize="14"/></StackPanel>
                <Border Grid.Row="2" Background="#0E2B21" BorderBrush="#1E5741" BorderThickness="1" CornerRadius="10" Padding="14"><StackPanel><DockPanel><Ellipse Width="7" Height="7" Fill="#3CF2A5" Margin="0,0,8,0"/><TextBlock Text="SISTEMA OPERATIVO" Foreground="#53E7A6" FontSize="10" FontWeight="Bold"/></DockPanel><TextBlock Text="Cloud API + Web asistido" Margin="0,8,0,0" FontSize="12"/><TextBlock Text="Protección y auditoría activas" Foreground="#789C8C" FontSize="10" Margin="0,3,0,0"/></StackPanel></Border>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="34,26,34,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><StackPanel><TextBlock Text="CENTRO DE COBRANZA" Foreground="#4DDB9D" FontSize="10" FontWeight="Bold"/><TextBlock Text="Panel operativo" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/><TextBlock x:Name="LastImportText" Text="Importa un Excel o CSV para comenzar" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="ImportButton" Content="＋  IMPORTAR DATOS" Click="ImportButton_Click" Background="#00A968" Foreground="White" BorderBrush="#58F1B2" BorderThickness="2" FontWeight="Bold" Margin="0,0,10,0"/><Button x:Name="ExportButton" Content="⇩  BORRADORES" Click="ExportButton_Click" Background="#1479C9" Foreground="White" BorderBrush="#61C2FF" BorderThickness="2" FontWeight="Bold" Margin="0,0,10,0"/><Button Content="⚙  AJUSTES" Click="SettingsButton_Click" Background="#7048D7" Foreground="White" BorderBrush="#AC91FF" BorderThickness="2" FontWeight="Bold" ToolTip="Configurar WhatsApp"/></StackPanel></Grid>
            <Grid Grid.Row="1" Margin="0,25,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,11,0"><Grid><StackPanel><TextBlock Text="CLIENTES" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="TotalText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><TextBlock Text="01" HorizontalAlignment="Right" Foreground="#24483A" FontSize="25" FontWeight="Bold"/></Grid></Border>
                <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,11,0"><Grid><StackPanel><TextBlock Text="PENDIENTES" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="PendingText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel><TextBlock Text="02" HorizontalAlignment="Right" Foreground="#24483A" FontSize="25" FontWeight="Bold"/></Grid></Border>
                <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#236A4B" BorderThickness="1" CornerRadius="12" Padding="19" Margin="0,0,11,0"><Grid><StackPanel><TextBlock Text="AUTORIZADOS" Foreground="#69CFA2" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="EligibleText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="{StaticResource Accent}"/></StackPanel><Ellipse Width="7" Height="7" Fill="#35E99B" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid></Border>
                <Border Grid.Column="3" Background="{StaticResource Panel}" BorderBrush="#633932" BorderThickness="1" CornerRadius="12" Padding="19"><Grid><StackPanel><TextBlock Text="BLOQUEADOS" Foreground="#C7887C" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="BlockedText" Text="0" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,0" Foreground="#FF8C7E"/></StackPanel><Ellipse Width="7" Height="7" Fill="#FF7B6B" HorizontalAlignment="Right" VerticalAlignment="Top"/></Grid></Border>
            </Grid>
            <Border Grid.Row="2" Background="#201C10" BorderBrush="#665522" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,14"><DockPanel><TextBlock Text="◆" Foreground="#FFD66B" Margin="0,0,10,0"/><TextBlock Text="Protección activa: consentimiento obligatorio, plantillas aprobadas y bloqueo automático de casos legales." Foreground="#D8C995" TextWrapping="Wrap"/></DockPanel></Border>
            <Border Grid.Row="3" Background="{StaticResource Panel2}" BorderBrush="#2C5A48" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="ACCIONES DE CAMPAÑA" Foreground="#9FC7B6" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="ConnectionText" Text="WhatsApp sin configurar" HorizontalAlignment="Right" Foreground="#6FE2AD" FontWeight="SemiBold"/></Grid><WrapPanel Grid.Row="1" Margin="0,10,0,0"><Button x:Name="SendButton" Content="⌕  FILTRAR" Click="SendButton_Click" Background="#1479C9" Foreground="White" BorderBrush="#61C2FF" BorderThickness="2" FontWeight="Bold" MinWidth="108"/><Button x:Name="SendFilteredButton" Content="◉  ENVIAR FILTRADOS" Click="SendFilteredButton_Click" Background="#00A968" Foreground="White" BorderBrush="#58F1B2" BorderThickness="2" FontWeight="Bold" MinWidth="165" Margin="9,0,0,0" IsEnabled="False"/><Button Content="▶  PLAYWRIGHT" Click="ManualButton_Click" Background="#7048D7" Foreground="White" BorderBrush="#AC91FF" BorderThickness="2" FontWeight="Bold" MinWidth="140" Margin="9,0,0,0"/><Button Content="✎  MENSAJE" Click="MessageButton_Click" Background="#B63F89" Foreground="White" BorderBrush="#FF8FD0" BorderThickness="2" FontWeight="Bold" MinWidth="115" Margin="9,0,0,0"/><Button Content="✓  PERMISOS MASIVOS" Click="BulkConsentButton_Click" Background="#C76A08" Foreground="White" BorderBrush="#FFB657" BorderThickness="2" FontWeight="Bold" MinWidth="170" Margin="9,0,0,0"/><Button Content="◷  HISTORIAL" Click="ExportHistoryButton_Click" Background="#087E96" Foreground="White" BorderBrush="#56D7ED" BorderThickness="2" FontWeight="Bold" MinWidth="120" Margin="9,0,0,0"/><Button x:Name="CancelButton" Content="■  CANCELAR" Click="CancelButton_Click" Background="#B83F38" Foreground="White" BorderBrush="#FF8B80" BorderThickness="2" FontWeight="Bold" MinWidth="115" Margin="9,0,0,0" IsEnabled="False"/></WrapPanel></Grid></Border>
            <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="0" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#10231C" BorderBrush="#24483A" BorderThickness="0,0,0,1" Padding="13,11"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="20" Foreground="#53DFA1" VerticalAlignment="Center" Margin="0,0,10,0"/><Border Grid.Column="1" Background="#091712" BorderBrush="#285140" BorderThickness="1" CornerRadius="8"><TextBox x:Name="SearchBox" Padding="11,8" FontSize="14" TextChanged="SearchBox_TextChanged" ToolTip="Contrato, nombre, cédula o teléfono" Background="Transparent" Foreground="#E7F4EE" BorderThickness="0" CaretBrush="#48E5A2"/></Border><Button Grid.Column="2" Content="Limpiar" Click="ClearSearchButton_Click" Background="#1A342B" BorderBrush="#31594A" BorderThickness="1" Margin="10,0,0,0" Padding="14,8"/><Button Grid.Column="3" Content="Mostrar todos" Click="ResetCampaignFilterButton_Click" Background="#203D32" BorderBrush="#386451" BorderThickness="1" Margin="8,0,0,0" Padding="14,8"/></Grid></Border>
                <DataGrid Grid.Row="1" x:Name="CustomersGrid" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="#0D1D18" Foreground="#DDEDE6" GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="43" ColumnHeaderHeight="40" CanUserAddRows="False"><DataGrid.Columns><DataGridTextColumn Header="CONTRATO" Binding="{Binding Contract}" Width="95"/><DataGridTextColumn Header="CÉDULA" Binding="{Binding NationalId}" Width="120"/><DataGridTextColumn Header="CLIENTE" Binding="{Binding FullName}" Width="*"/><DataGridTextColumn Header="TELÉFONO" Binding="{Binding Phone}" Width="120"/><DataGridTextColumn Header="BALANCE" Binding="{Binding BalanceText}" Width="110"/><DataGridTextColumn Header="ESTADO" Binding="{Binding StageText}" Width="130"/><DataGridTextColumn Header="PERMISO" Binding="{Binding ConsentText}" Width="75"/></DataGrid.Columns></DataGrid>
            </Grid></Border>
            <Grid Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="Sistema listo" Foreground="{StaticResource TextMuted}"/><TextBlock Text="BLOOM CORE  /  SECURE LOCAL MODE" HorizontalAlignment="Right" Foreground="#35594B" FontSize="9" FontWeight="SemiBold"/></Grid>
        </Grid>
    </Grid>
</Window>
