<Window x:Class="BloomCobrosAgent.MessageEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Editor de mensaje" Width="760" Height="700" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#07110E">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EDF8F3"/><Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/></Style>
    </Window.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="EDITOR DE MENSAJE" Foreground="#4DDB9D" FontSize="10" FontWeight="Bold"/>
            <TextBlock Text="Personaliza tu comunicación" FontSize="27" FontWeight="SemiBold" Margin="0,6,0,0"/>
            <TextBlock Text="Este texto se usa en Playwright y borradores. La API oficial usa el contenido de la plantilla aprobada en Meta." Foreground="#91ACA0" TextWrapping="Wrap" Margin="0,6,0,20"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#10231C" BorderBrush="#285140" BorderThickness="1" CornerRadius="9" Padding="13" Margin="0,0,0,14">
            <StackPanel><TextBlock Text="VARIABLES DISPONIBLES" Foreground="#65DDA8" FontSize="10" FontWeight="Bold"/><TextBlock Text="{}{nombre}   {nombre_completo}   {balance}   {contrato}   {fecha_vencimiento}   {estado}" Foreground="#C8DDD4" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0"><TextBlock Text="MENSAJE" FontSize="11" FontWeight="Bold" Foreground="#91ACA0" Margin="0,0,0,7"/><Border Background="#0D1D18" BorderBrush="#285140" BorderThickness="1" CornerRadius="10"><TextBox x:Name="TemplateBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="Transparent" Foreground="#E8F5EF" CaretBrush="#47E4A1" BorderThickness="0" Padding="14" FontSize="14" TextChanged="TemplateBox_TextChanged"/></Border></StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="VISTA PREVIA" FontSize="11" FontWeight="Bold" Foreground="#91ACA0" Margin="0,0,0,7"/><Border Background="#102820" BorderBrush="#2A6B50" BorderThickness="1" CornerRadius="10" Padding="15"><TextBlock x:Name="PreviewText" Foreground="#E8F5EF" TextWrapping="Wrap" FontSize="14"/></Border></StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,12,0,0"><TextBlock x:Name="CounterText" Foreground="#91ACA0"/><Button Content="Restaurar mensaje" Click="ResetButton_Click" HorizontalAlignment="Right" Background="#1A342B" BorderBrush="#31594A" BorderThickness="1"/></Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="Cancelar" Click="CancelButton_Click" Background="#374B43" Margin="0,0,10,0"/><Button Content="Guardar mensaje" Click="SaveButton_Click" Background="#00A968" BorderBrush="#58F1B2" BorderThickness="2" FontWeight="Bold"/></StackPanel>
    </Grid>
</Window>
