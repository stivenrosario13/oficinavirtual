<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers><add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" /></handlers>
      <aspNetCore processPath="dotnet" arguments=".\RegistroAgencias.LicenseServer.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <httpProtocol><customHeaders><remove name="X-Powered-By" /><add name="X-Content-Type-Options" value="nosniff" /><add name="X-Frame-Options" value="DENY" /><add name="Referrer-Policy" value="no-referrer" /></customHeaders></httpProtocol>
    </system.webServer>
  </location>
</configuration>
